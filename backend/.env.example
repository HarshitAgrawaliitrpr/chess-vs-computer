# Copy to `.env` (or set in Vercel Settings -> Environment Variables).

# --- Database (Turso) -------------------------------------------------------
# Local dev needs none of this: defaults to file:./chess.db (gitignored).
# Production (libsql:// and https:// URLs both work - normalised in app/db.py):
#   turso db create chess-vs-computer
#   turso db show chess-vs-computer            # DATABASE_URL
#   turso db tokens create chess-vs-computer   # DATABASE_AUTH_TOKEN
DATABASE_URL=file:./chess.db
DATABASE_AUTH_TOKEN=

# --- Sessions ---------------------------------------------------------------
# JWT signing secret (>= 32 random chars). Local dev auto-generates
# <repo>/.jwt-secret when this is unset.
SECRET_KEY=
JWT_EXPIRE_DAYS=30

# --- Google sign-in (optional) ---------------------------------------------
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorized origin: http://localhost:5173 (+ the Vercel domain).
GOOGLE_CLIENT_ID=

# --- CORS -------------------------------------------------------------------
ALLOWED_ORIGINS=*
